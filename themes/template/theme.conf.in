; omarime — generated fcitx5 classicui theme
; Palette : @ACTIVE_NAME@ (@MODE@)
; Radius  : @RADIUS@ px (mirrors decoration:rounding)
; Font    : @FONT_FAMILY@
; Generated by omarime-theme; do not edit — regenerate instead.

[Metadata]
Name=omarime
Version=1
Author=omarime
Description=Omarchy-native · @ACTIVE_NAME@
ScaleWithDPI=True

[InputPanel]
NormalColor=@TEXT@@TEXT_ALPHA@
HighlightColor=@ACCENT@
HighlightBackgroundColor=#00000000
HighlightCandidateColor=@SELECTED_TEXT@
CandidateLabelColor=@LABEL@
HighlightCandidateLabelColor=@SELECTED_LABEL@
LabelTextSizeFactor=85
CommentTextSizeFactor=70
FullWidthHighlight=True
PageButtonAlignment=Bottom

[InputPanel/Background]
Image=panel.svg

[InputPanel/Background/Margin]
Left=@PANEL_MARGIN@
Right=@PANEL_MARGIN@
Top=@PANEL_MARGIN@
Bottom=@PANEL_MARGIN@

[InputPanel/ContentMargin]
Left=12
Right=12
Top=8
Bottom=8

[InputPanel/TextMargin]
Left=7
Right=7
Top=4
Bottom=4

[InputPanel/Highlight]
Image=highlight.svg

[InputPanel/Highlight/Margin]
Left=6
Right=6
Top=3
Bottom=3

[InputPanel/Highlight/ClickMargin]
Left=4
Right=4
Top=2
Bottom=2

[InputPanel/PrevPage]
Image=prev.svg

[InputPanel/PrevPage/ClickMargin]
Left=8
Right=8
Top=6
Bottom=6

[InputPanel/NextPage]
Image=next.svg

[InputPanel/NextPage/ClickMargin]
Left=8
Right=8
Top=6
Bottom=6

[Menu]
NormalColor=@TEXT@@TEXT_ALPHA@
HighlightCandidateColor=@SELECTED_TEXT@
Spacing=2

[Menu/Background]
Image=panel.svg

[Menu/Background/Margin]
Left=@PANEL_MARGIN@
Right=@PANEL_MARGIN@
Top=@PANEL_MARGIN@
Bottom=@PANEL_MARGIN@

[Menu/ContentMargin]
Left=10
Right=10
Top=8
Bottom=8

[Menu/TextMargin]
Left=8
Right=8
Top=5
Bottom=5

[Menu/Highlight]
Image=highlight.svg

[Menu/Highlight/Margin]
Left=5
Right=5
Top=3
Bottom=3

[Menu/Separator]
Color=@TEXT@@SEPARATOR_ALPHA@

[Menu/CheckBox]
Image=radio.svg

[Menu/SubMenu]
